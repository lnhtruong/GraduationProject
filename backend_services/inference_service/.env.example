# ─── Inference Service ─────────────────────────────────────────────
# Port nội bộ. API Gateway sẽ proxy /api/mascot_colab/** → cổng này.
PORT=8007

# ─── Colab Worker Pool ─────────────────────────────────────────────
# Khuyến nghị (multi-worker, scale ngang): liệt kê các URL ngrok cách
# nhau bằng dấu phẩy. Mỗi URL là 1 Colab notebook đang chạy server FastAPI.
COLAB_API_URLS=https://worker-1.ngrok-free.dev,https://worker-2.ngrok-free.dev

# Fallback (legacy, 1 worker duy nhất) — dùng khi không set COLAB_API_URLS.
# COLAB_API_URL=https://famous-headlong-deon.ngrok-free.dev

# Timeout (ms) cho probe health của mỗi worker khi service pick worker.
COLAB_HEALTH_TIMEOUT_MS=3000
# In-memory cache (ms) cho kết quả health để tránh probe mỗi request.
COLAB_HEALTH_CACHE_TTL_MS=5000
# Path probe trên Colab — Colab notebook trả JSON ở `GET /`.
COLAB_HEALTH_PATH=/
# Timeout (ms) cho request inference thật (upload video lớn → để dài).
COLAB_REQUEST_TIMEOUT_MS=600000

# ─── Redis (dùng để map jobId → colabUrl, share giữa các instance) ──
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
# TTL của mapping job (giây). Mặc định 7 ngày — đủ cho user poll và download.
COLAB_JOB_TTL_SECONDS=604800

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=graduation_user
DB_PASSWORD=graduation_password
DB_DATABASE=graduation_db
