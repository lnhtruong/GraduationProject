# ─── Inference Service ─────────────────────────────────────────────
# Port nội bộ. API Gateway sẽ proxy /api/mascot_colab/** → cổng này.
PORT=8007

# ─── Colab Worker Pools (2 pool riêng theo loại tác vụ) ────────────
# Pool "highlight": notebook 03_07_multi_output — phục vụ /transcribe,
# /highlight-reel, /highlight-reel-link, /generate-quiz.
HIGHLIGHT_COLAB_API_URLS=https://highlight-worker-1.ngrok-free.dev,https://highlight-worker-2.ngrok-free.dev
# Fallback 1 worker duy nhất:
# HIGHLIGHT_COLAB_API_URL=https://highlight-worker-1.ngrok-free.dev

# Pool "mascot": notebook RemoveBackground_Mascot — phục vụ /mascot, /download.
MASCOT_COLAB_API_URLS=https://mascot-worker-1.ngrok-free.dev,https://mascot-worker-2.ngrok-free.dev
# Fallback 1 worker duy nhất:
# MASCOT_COLAB_API_URL=https://mascot-worker-1.ngrok-free.dev

# Legacy (dùng chung cho pool nào chưa set biến riêng ở trên).
# COLAB_API_URLS=https://worker-1.ngrok-free.dev,https://worker-2.ngrok-free.dev
# COLAB_API_URL=https://famous-headlong-deon.ngrok-free.dev

# Timeout (ms) cho probe health của mỗi worker khi service pick worker.
COLAB_HEALTH_TIMEOUT_MS=3000
# In-memory cache (ms) cho kết quả health để tránh probe mỗi request.
COLAB_HEALTH_CACHE_TTL_MS=5000
# Path probe trên Colab — Colab notebook trả JSON ở `GET /`.
COLAB_HEALTH_PATH=/
# Timeout (ms) cho request inference thật (upload video lớn → để dài).
COLAB_REQUEST_TIMEOUT_MS=600000

# ─── Media Service (tra srt_raw_url khi highlight dùng keep/remove ranges) ──
MEDIA_SERVICE_URL=http://localhost:8003

# ─── Redis (dùng để map jobId → colabUrl, share giữa các instance) ──
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
# TTL của mapping job (giây). Mặc định 7 ngày — đủ cho user poll và download.
COLAB_JOB_TTL_SECONDS=604800

# ─── AI quota (credit chung theo cửa sổ 24h, đếm trên Redis) ───────
# Đặt false để tắt hoàn toàn kiểm tra quota (dùng cho dev).
QUOTA_ENABLED=true

# Credit mỗi cửa sổ 24h theo role (1 = admin, 2 = student, 3 = lecturer).
QUOTA_DAILY_STUDENT=100
QUOTA_DAILY_LECTURER=500
QUOTA_DAILY_ADMIN=500

# Credit mỗi loại job, tất cả tính theo PHÚT video
# (phút lẻ làm tròn lên, tối thiểu 1 phút).
# Quiz tính theo đoạn video được chọn, không phải cả video.
QUOTA_COST_HIGHLIGHT=1
QUOTA_COST_TRANSCRIBE=1
QUOTA_COST_QUIZ=2
QUOTA_COST_MASCOT=10

# Trần thời lượng dùng để tính giá (giây). Mặc định 4 giờ.
QUOTA_MAX_DURATION_SEC=14400
# Độ dài cửa sổ quota (giây). Mặc định 24h, tính từ lần trừ credit đầu tiên của
# mỗi người dùng — Redis tự xoá counter khi hết hạn, không cần cron.
QUOTA_WINDOW_SECONDS=86400
# TTL của record hoàn credit theo job (giây). Phải dài hơn thời gian job chạy.
QUOTA_JOB_TTL_SECONDS=172800

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=graduation_user
DB_PASSWORD=graduation_password
DB_DATABASE=graduation_db

# Shared secret cho endpoint nội bộ /quota/reserve, /quota/refund.
# PHẢI khớp INTERNAL_SERVICE_SECRET của course_service. Bỏ trống = tắt kiểm tra.
INTERNAL_SERVICE_SECRET=fivetoneu2026
