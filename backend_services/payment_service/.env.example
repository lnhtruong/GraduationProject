PORT=3000

# PayOS Configuration
PAYOS_CLIENT_ID=your_client_id_here
PAYOS_API_KEY=your_api_key_here
PAYOS_CHECKSUM_KEY=your_checksum_key_here

# 🔴 WEBHOOK URL - QUAN TRỌNG!
# Phải là URL công khai mà PayOS có thể gọi tới
PAYOS_WEBHOOK_URL=https://payment-service-domain-public.com/payment/payos-callback

# Payment URLs (Optional - defaults to localhost:PORT)
# UI nếu thanh toán bị huỷ
# PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
# UI nếu thanh toán thành công
# PAYOS_RETURN_URL=http://localhost:3000/payment/return

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_here
