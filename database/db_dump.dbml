	Submissions.user_id > Users.id [ delete: no action, update: no action ]
}

Ref fk_Submissions_grader_id_Users {
	Submissions.grader_id - Users.id [ delete: no action, update: no action ]
}

Ref fk_Lesson_Activities_created_by_Users {
	Lesson_Activities.created_by > Users.id [ delete: no action, update: no action ]
}

