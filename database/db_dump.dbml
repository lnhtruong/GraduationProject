	Quizzes.lesson_activity_id - Lesson_Activities.id [ delete: no action, update: no action ]
}

Ref fk_Assignments_lesson_activity_id_Lesson_Activities {
	Assignments.lesson_activity_id - Lesson_Activities.id [ delete: no action, update: no action ]
}

Ref fk_Submission_Answers_submission_id_Submissions {
	Submission_Answers.submission_id > Submissions.id [ delete: no action, update: no action ]
}

Ref fk_Submission_Answers_question_id_Lesson_Activities {
	Submission_Answers.question_id - Lesson_Activities.id [ delete: no action, update: no action ]
}

Ref fk_Courses_categories_Categories {
	Courses.categories < Categories.id [ delete: no action, update: no action ]
}

Ref fk_Reviews_user_id_Users {
	Reviews.user_id > Users.id [ delete: no action, update: no action ]
}

Ref fk_Reviews_course_id_Courses {
	Reviews.course_id > Courses.id [ delete: no action, update: no action ]
}

Ref fk_Course_Certificate_Templates_certificate_id_Certificate_Templates {
	Course_Certificate_Templates.certificate_id > Certificate_Templates.id [ delete: no action, update: no action ]
}

Ref fk_Course_Certificate_Templates_course_id_Courses {
	Course_Certificate_Templates.course_id > Courses.id [ delete: no action, update: no action ]
}

Ref fk_Issue_Certificates_user_id_Users {
	Issued_Certificates.user_id > Users.id [ delete: no action, update: no action ]
}

Ref fk_Issue_Certificates_certificate_template_id_Certificate_Templates {
	Issued_Certificates.certificate_template_id > Certificate_Templates.id [ delete: no action, update: no action ]
}

Ref fk_Issue_Certificates_course_id_Courses {
	Issued_Certificates.course_id > Courses.id [ delete: no action, update: no action ]
}

Ref fk_Mascot_Image_user_id_Users {
	Mascot_Image.user_id > Users.id [ delete: no action, update: no action ]
}

Ref fk_Mascot_Videos_image_id_Mascot_Image {
	Mascot_Videos.image_id - Mascot_Image.image_id [ delete: no action, update: no action ]
}

Ref fk_Mascot_Overlay_mascot_video_id_Mascot_Videos {
	Mascot_Overlay.mascot_video_id > Mascot_Videos.mascot_video_id [ delete: no action, update: no action ]
}

Ref fk_Mascot_Overlay_edit_id_Projects {
	Mascot_Overlay.edit_id - Projects.edit_id [ delete: no action, update: no action ]
}

Ref fk_Projects_user_id_Users {
	Projects.user_id > Users.id [ delete: no action, update: no action ]
}

Ref fk_Highlight_Videos_user_id_Users {
	Highlight_Videos.user_id > Users.id [ delete: no action, update: no action ]
}

Ref fk_Projects_highlight_id_Highlight_Videos {
	Projects.highlight_id - Highlight_Videos.highlight_id [ delete: no action, update: no action ]
}

Ref fk_Text_Overlay_edit_id_Projects {
	Text_Overlay.edit_id > Projects.edit_id [ delete: no action, update: no action ]
}

Ref fk_Visual_Effects_edit_id_Projects {
	Visual_Effects.edit_id - Projects.edit_id [ delete: no action, update: no action ]
}

Ref fk_Audio_edit_id_Projects {
	Audio.edit_id > Projects.edit_id [ delete: no action, update: no action ]
}

Ref fk_Final_Video_edit_id_Projects {
	Final_Video.edit_id - Projects.edit_id [ delete: no action, update: no action ]
}

Ref fk_Final_Video_user_id_Users {
	Final_Video.user_id > Users.id [ delete: no action, update: no action ]
}

Ref fk_Voice_Profile_user_id_Users {
	Voice_Profile.user_id > Users.id [ delete: no action, update: no action ]
}

Ref fk_Audio_voice_profile_id_Voice_Profile {
	Audio.voice_profile_id - Voice_Profile.voice_profile_id [ delete: no action, update: no action ]
}

Ref fk_Payments_user_id_Users {
	Payments.user_id > Users.id [ delete: no action, update: no action ]
}

Ref fk_Payments_course_id_Courses {
	Payments.course_id - Courses.id [ delete: no action, update: no action ]
}

Ref fk_DiscussionForum_user_id_Users {
	DiscussionForum.user_id > Users.id [ delete: no action, update: no action ]
}

Ref fk_DiscussionForum_course_id_Courses {
	DiscussionForum.course_id > Courses.id [ delete: no action, update: no action ]
}

Ref fk_Notifications_user_id_Users {
	Notifications.user_id > Users.id [ delete: no action, update: no action ]
}

Ref fk_Transactions_user_id_Users {
	Transactions.user_id > Users.id [ delete: no action, update: no action ]
}

Ref fk_Transaction_Items_transaction_id_Transactions {
	Transaction_Items.transaction_id > Transactions.id [ delete: cascade, update: no action ]
}

Ref fk_Transaction_Items_course_id_Courses {
	Transaction_Items.course_id > Courses.id [ delete: no action, update: no action ]
}