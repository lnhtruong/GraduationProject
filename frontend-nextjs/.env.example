# REST API base URL 
NEXT_PUBLIC_API_BASE_URL=

# Public frontend origin used for metadata, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=

# Google Sign-In client ID for the frontend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Upload size config. Defaults in code: Cloudinary 100MB, Bunny 4096MB.
NEXT_PUBLIC_CLOUDINARY_MAX_UPLOAD_MB=100
NEXT_PUBLIC_BUNNY_MAX_UPLOAD_MB=4096

# Platform fee shown in admin/instructor revenue notices. Leave empty to show N%.
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=
