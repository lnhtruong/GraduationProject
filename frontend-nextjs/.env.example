# REST API base URL 
NEXT_PUBLIC_API_BASE_URL=

# Public frontend origin used for metadata, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=

# Google Sign-In client ID for the frontend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Upload size config. Defaults in code: Cloudinary 100MB, Bunny 4096MB.
NEXT_PUBLIC_CLOUDINARY_MAX_UPLOAD_MB=100
NEXT_PUBLIC_BUNNY_MAX_UPLOAD_MB=4096

# Platform fee shown in admin/instructor revenue notices. Leave empty to show N%.
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=

# Instructor revenue withholding fallback. Backend values remain authoritative.
NEXT_PUBLIC_INSTRUCTOR_VAT_WITHHOLDING_PERCENT=5
NEXT_PUBLIC_INSTRUCTOR_PIT_WITHHOLDING_PERCENT=2
NEXT_PUBLIC_INSTRUCTOR_TAX_EXEMPT_ANNUAL_REVENUE_VND=1000000000
# gross | after_platform_fee
NEXT_PUBLIC_INSTRUCTOR_TAX_BASE_MODE=gross
