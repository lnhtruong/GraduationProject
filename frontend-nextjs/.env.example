# REST API base URL 
NEXT_PUBLIC_API_BASE_URL=

# Public frontend origin used for assets under /public, e.g. preset mascot images.
# Set this to an externally reachable URL when the mascot worker runs outside localhost.
NEXT_PUBLIC_SITE_URL=

# Google Sign-In client ID for the frontend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Set to "true" to use mock data for analytics, "false" to call real API
NEXT_PUBLIC_USE_MOCK_STATS=true

# Set to "true" to use mock data for reports, "false" to call real API
NEXT_PUBLIC_USE_MOCK_REPORT=false

# Set to "true" to use mock data for admin course review, "false" to call real API
NEXT_PUBLIC_USE_MOCK_ADMIN_REVIEW=true
